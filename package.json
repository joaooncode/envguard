{
  "name": "envguard",
  "version": "0.1.0",
  "private": true,
  "description": "Prevent .env files and environment secrets from accidentally reaching Git.",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint:go": "gofmt -l . && go vet ./..."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
